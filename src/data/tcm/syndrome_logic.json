        "CV6",
        "KI7",
        "BL23",
        "CV14"
      ],
      "ni_comment": "倪师认为少阴病为六经病之危重阶段心肾阳气衰微。脉微细但欲寐为少阴病之总纲。寒化证为阳虚寒盛用四逆汤类回阳救逆。热化证为阴虚火旺用黄连阿胶汤滋阴清热。倪师强调少阴病当急温之不可迟疑。"
    },
    {
      "name": "厥阴经",
      "english_name": "Jue Yin",
      "description": "厥阴为阴尽阳生之经主肝主风。厥阴病为阴阳交争寒热错杂之证。厥阴经脉起于大指丛毛之际上循足跗上廉去内踝一寸上踝八寸交出太阴之后上腘内廉。厥阴病以消渴气上撞心心中疼热饥而不欲食食则吐蛔为纲。",
      "key_symptoms": [
        "消渴",
        "气上撞心",
        "心中疼热",
        "饥而不欲食",
        "食则吐蛔",
        "四肢厥冷",
        "寒热交错",
        "下利"
      ],
      "tongue_pulse": {
        "tongue": "舌暗红苔黄白相兼",
        "pulse": "脉沉弦或微"
      },
      "classic_formulas": [

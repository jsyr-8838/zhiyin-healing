{
  "six_meridian_syndromes": [
    {
      "name": "太阳经",
      "english_name": "Tai Yang",
      "description": "太阳为一身之藩篱主一身之表统营卫而主表。太阳病为外感病之初期邪在表位。太阳经脉起于目内眦上额交巅入络脑还出别下项循肩髆内挟脊抵腰中。太阳为六经之纲领外邪侵袭首先犯太阳。",
      "key_symptoms": [
        "头痛项强",
        "恶寒发热",
        "脉浮",
        "有汗（中风证）",
        "无汗（伤寒证）",
        "鼻鸣干呕",
        "身疼腰痛",
        "骨节疼痛",
        "气喘"
      ],
      "tongue_pulse": {
        "tongue": "舌苔薄白",
        "pulse": "脉浮（中风脉浮缓，伤寒脉浮紧）"
      },
      "classic_formulas": [
        "F001",
        "F002",
        "F003",
        "F004",
        "F005",
        "F006",
        "F007",
        "F008",
        "F009",
        "F010"
      ],
      "key_acupoints": [
        "LU7",
        "LI4",
        "BL10",
        "GB20",
        "DU14",
        "BL12",
        "BL13"
      ],
      "ni_comment": "倪师认为太阳病为外感病之初期病位在表。太阳中风与太阳伤寒之鉴别关键在于有汗与无汗。中风为风伤卫卫气不固营气外泄故汗出恶风用桂枝汤调和营卫。伤寒为寒伤营营血凝滞故无汗身疼用麻黄汤发汗解表。太阳病当以解表为第一要务不可过早攻下。"
    },
    {
      "name": "阳明经",
      "english_name": "Yang Ming",
      "description": "阳明为多气多血之经主里主热。阳明病为外邪化热入里之极期。阳明经脉起于鼻之交頞中旁纳太阳之脉下循鼻外入上齿中还出挟口环唇下交承浆。阳明病以胃家实为纲分为阳明经证与阳明腑证。",
      "key_symptoms": [
        "身热汗自出",
        "不恶寒反恶热",
        "大渴引饮",
        "脉洪大",
        "腹满痛",
        "大便秘结",
        "谵语",
        "潮热",
        "手足濈然汗出"
      ],
      "tongue_pulse": {
        "tongue": "舌红苔黄燥或焦黑起刺",
        "pulse": "脉洪大（经证）或脉沉实（腑证）"
      },
      "classic_formulas": [
        "F030",
        "F031",
        "F032",
        "F033",
        "F034",
        "F035",
        "F136",
        "F137"
      ],
      "key_acupoints": [
        "LI11",
        "ST44",
        "ST36",
        "ST25",
        "ST37",
        "CV12",
        "GV14"
      ],
      "ni_comment": "倪师认为阳明病为外感热病之极期邪已入里化热。阳明经证以四大症状为辨证要点壮热大汗大渴脉洪大用白虎汤清热。阳明腑证以痞满燥实坚为辨证要点用承气汤攻下。倪师强调阳明病当急下存阴不可迟疑。"
    },
    {
      "name": "少阳经",
      "english_name": "Shao Yang",
      "description": "少阳为半表半里之经主枢。少阳病为邪正相争于半表半里之间。少阳经脉起于目锐眦上抵头角下耳后循颈入缺盆。少阳为三阳之枢邪在少阳既不在表也不在里故治法以和解为主。",
      "key_symptoms": [
        "往来寒热",
        "胸胁苦满",
        "默默不欲饮食",
        "心烦喜呕",
        "口苦",
        "咽干",
        "目眩",
        "脉弦"
      ],
      "tongue_pulse": {
        "tongue": "舌边红苔薄白或微黄",
        "pulse": "脉弦"
      },
      "classic_formulas": [
        "F003",
        "F017",
        "F018",
        "F019",
        "F168"
      ],
      "key_acupoints": [
        "GB34",
        "GB20",
        "LR3",
        "GB41",
        "TE5",
        "GB25"
      ],
      "ni_comment": "倪师认为少阳病为邪在半表半里治当和解。往来寒热胸胁苦满默默不欲饮食心烦喜呕为少阳病之四大主症用小柴胡汤和解少阳。少阳病禁汗禁吐禁下此为三禁。若少阳兼阳明里实则用大柴胡汤和解与通下并用。"
    },
    {
      "name": "太阴经",
      "english_name": "Tai Yin",
      "description": "太阴为三阴之首主脾主运化。太阴病为脾阳虚寒之证。太阴经脉起于大指之端循指内侧白肉际过核骨后上内踝前廉上腨内循胫骨后交出厥阴前。太阴病以腹满而吐食不下自利益甚时腹自痛为纲。",
      "key_symptoms": [
        "腹满而吐",
        "食不下",
        "自利益甚",
        "时腹自痛",
        "口不渴",
        "手足温",
        "脉沉迟"
      ],
      "tongue_pulse": {
        "tongue": "舌淡苔白腻或白滑",
        "pulse": "脉沉迟或缓弱"
      },
      "classic_formulas": [
        "F039",
        "F040",
        "F041",
        "F165",
        "F079",
        "F089"
      ],
      "key_acupoints": [
        "CV12",
        "ST36",
        "SP6",
        "SP9",
        "BL20",
        "CV6"
      ],
      "ni_comment": "倪师认为太阴病为脾阳虚寒之证病机在于脾失健运寒湿内停。腹满而吐食不下自利益甚为太阴病之主症。治当温中散寒用理中汤类方。倪师强调太阴病当以温阳健脾为根本不可过用苦寒之品。"
    },
    {
      "name": "少阴经",
      "english_name": "Shao Yin",
      "description": "少阴为心肾之本主水火。少阴病为心肾阳虚或阴虚之极期。少阴经脉起于小指之端斜走足心出于然谷之下循内踝之后入跟中上腨内。少阴病以脉微细但欲寐为纲分为寒化证与热化证。",
      "key_symptoms": [
        "脉微细",
        "但欲寐",
        "恶寒蜷卧",
        "四肢厥冷",
        "下利清谷",
        "小便清长",
        "精神萎靡",
        "欲吐不吐"
      ],
      "tongue_pulse": {
        "tongue": "舌淡白或淡紫（寒化证）舌红少苔（热化证）",
        "pulse": "脉微细欲绝（寒化证）或脉细数（热化证）"
      },
      "classic_formulas": [
        "F042",
        "F043",
